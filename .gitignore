# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build output — both are reproducible from package-lock.json
# and `npm run build`, so neither belongs in the repo.
node_modules
dist
dist-ssr
*.local

# Vite's dependency pre-bundling cache
.vite

# Secrets. Nothing here needs them today (the database is seeded in the
# browser and there is no backend), but committing one by reflex is the
# expensive kind of mistake.
.env
.env.*
!.env.example

# Host / platform artifacts
.vercel
.netlify
.firebase

# Scratch marker written by the session that syncs this folder
# (both spellings — the project was renamed from its original name)
.datapulse_sync
.rowspace_sync

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
